{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kunnskapsspillet-buzzer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Ingen lagrede logger: ingen spilldata blir liggende hos Cloudflare.
  "observability": { "enabled": false },
  "vars": {
    "TILLATTE_OPPRINNELSER": "https://kunnskapsspillet.laererliv.no"
  },
  "ratelimits": [{ "name": "BEGRENS", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "durable_objects": {
    "bindings": [{ "name": "ROM", "class_name": "Rom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rom"] }]
}
